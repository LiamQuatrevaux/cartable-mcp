[Unit]
Description=Ecole Directe MCP server (read-only, stdio)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/ecoledirecte
Environment=ED_CREDENTIALS_FILE=/etc/ecoledirecte-mcp/credentials.json
Environment=ED_QCM_FILE=/var/lib/ecoledirecte-mcp/qcm.json
Environment=ED_DOWNLOAD_DIR=/var/lib/ecoledirecte-mcp/downloads
Environment=ED_READ_ONLY=true
Environment=ED_MAX_DOWNLOAD_MB=25
Environment=ED_LOG_LEVEL=WARNING
StateDirectory=ecoledirecte-mcp
ExecStart=/opt/ecoledirecte/.venv/bin/ecoledirecte-mcp
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/ecoledirecte-mcp
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=multi-user.target
